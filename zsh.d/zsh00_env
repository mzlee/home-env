# .zsh_env

if [[ -f /etc/zshrc ]]; then
    source /etc/zshrc
fi

for _dir in "$HOME/bin" "$HOME/.local/bin" "$HOME/homebrew/bin" "/opt/homebrew/bin" "/Applications/Docker.app/Contents/Resources/bin"; do
    if [[ -d "$_dir" && "$PATH" != *$_dir* ]]; then
	export PATH="$_dir:$PATH"
    fi
done

autoload -U select-word-style
select-word-style bash

export EDITOR=emacs
